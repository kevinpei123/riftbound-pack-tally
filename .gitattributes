# Keep source/docs stable across Windows/macOS/Linux.
* text=auto eol=lf

# Source and project text files.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts.
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts.
*.apk binary
*.aab binary
*.dex binary
*.so binary
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary
